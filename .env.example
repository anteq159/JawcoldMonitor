DB_PASSWORD=change_me_strong_password
SECRET_KEY=change_me_at_least_32_chars_random_string
PREVIEW_MODE=false
# Port HTTP panelu WWW (edytowalny też w zakładce Ustawienia)
PANEL_PORT=80
# Najlepiej stała ścieżka z /dev/serial/by-id/ (nie zmienia się po
# ponownym podłączeniu adaptera); install.sh wykrywa ją sam.
RS485_PORTS=/dev/ttyUSB0
RS485_BAUDRATE=9600
# Bity stopu RS485 (1 lub 2). Niektóre sterowniki (np. Carel MPXPRO,
# port supervisor 19200 8N2) wymagają 2 - bez tego nie odpowiadają mimo
# poprawnego okablowania.
RS485_STOPBITS=1
# Parzystość N/E/O - wszystkie urządzenia na magistrali muszą mieć tę samą
# (Schneider ATV320 fabrycznie 8E1, da się przestawić na 8N1/8N2)
RS485_PARITY=N
ALLOWED_ORIGINS=http://localhost

# --- Alarmy systemowe ---
# Urzadzenie offline dluzej niz N minut (0 wylacza)
OFFLINE_ALARM_MINUTES=5
# Urzadzenie offline odpytywane najwyzej co N sekund (oszczedza magistrale)
OFFLINE_POLL_INTERVAL=60
# Alarm zapelnienia dysku powyzej N procent (0 wylacza)
DISK_ALARM_PERCENT=90

# --- Powiadomienia e-mail (puste SMTP_HOST wylacza kanal) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# --- Powiadomienia Telegram (puste pola wylaczaja kanal) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Powiadomienia SMS (SMSAPI.pl, Twilio albo modem GSM w USB; puste pola wylaczaja kanal) ---
SMS_PROVIDER=smsapi
# modem: SMS_PROVIDER=modem, port modemu (inny niz RS485), PIN karty SIM
SMS_MODEM_PORT=
SMS_MODEM_BAUDRATE=115200
SMS_MODEM_PIN=
SMS_API_TOKEN=
SMS_ACCOUNT_SID=
SMS_SENDER=
SMS_TO=
SMS_DAILY_LIMIT=30

# Ktore kanaly dostaja alarmy systemowe/sprzetowe: email,telegram,sms
NOTIFY_SYSTEM_CHANNELS=

# --- Automatyczne kopie zapasowe ---
BACKUP_AUTO_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=backups
BACKUP_RETENTION_COUNT=14
