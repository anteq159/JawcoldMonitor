#!/usr/bin/env bash
# jawcold - obsługa instalacji JawcoldMonitor na hoście (Raspberry Pi).
#
#   jawcold status      stan kontenerów i wersja
#   jawcold update      pobiera nową wersję (obrazy z GHCR) i restartuje
#   jawcold rollback    wraca do wersji sprzed ostatniego `update`
#   jawcold restart     restart aplikacji (bez zmiany wersji)
#   jawcold apply       stosuje zmiany z .env (np. PANEL_PORT) - compose up -d
#   jawcold logs [usł.] ostatnie logi (domyślnie backend)
#
# Uruchamiane ręcznie na Raspberry (SSH). Kontener nie może sam podmienić
# swojego obrazu ani zmienić mapowania portów, więc te operacje wykonuje
# się tutaj, na hoście.
set -uo pipefail

INSTALL_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$INSTALL_DIR" || exit 1

if docker info >/dev/null 2>&1; then DOCKER="docker"; else DOCKER="sudo docker"; fi
COMPOSE="$DOCKER compose"
APP_SERVICES="backend frontend"

log() { echo -e "\033[1;32m[jawcold]\033[0m $*"; }
warn() { echo -e "\033[1;33m[jawcold]\033[0m $*" >&2; }

image_of() { $COMPOSE config --images 2>/dev/null | grep -m1 "jawcoldmonitor-$1"; }

# Keep the currently running images under a local tag, so `rollback` works
# offline and without relying on version tags in the registry.
save_rollback_point() {
    local svc img id
    for svc in $APP_SERVICES; do
        img="$(image_of "$svc")"
        id="$($DOCKER image inspect -f '{{.Id}}' "$img" 2>/dev/null)" || continue
        $DOCKER tag "$id" "jawcold-rollback/$svc:previous"
    done
}

pull_or_build() {
    if [ "${JAWCOLD_BUILD:-}" = "local" ] || grep -qE '^JAWCOLD_BUILD=local' .env 2>/dev/null; then
        log "Budowanie obrazów lokalnie (JAWCOLD_BUILD=local)..."
        $COMPOSE build $APP_SERVICES || return 1
        $COMPOSE pull postgres || true
        return 0
    fi
    if $COMPOSE pull; then
        return 0
    fi
    warn "Nie udało się pobrać gotowych obrazów - buduję lokalnie (kilka-kilkanaście minut)..."
    $COMPOSE build $APP_SERVICES
}

cmd_update() {
    if [ -d .git ]; then
        git pull --ff-only || warn "git pull nie powiódł się - kontynuuję z obecnymi plikami"
    fi
    save_rollback_point
    pull_or_build || return 1
    $COMPOSE up -d --remove-orphans postgres || return 1
    # Forced: after a local `compose build` compose does not always notice
    # that the image behind an unchanged tag is new, and kept running the
    # old frontend.
    $COMPOSE up -d --force-recreate --no-deps $APP_SERVICES || return 1
    $DOCKER image prune -f >/dev/null 2>&1 || true
    log "Zaktualizowano."
}

cmd_rollback() {
    local svc img
    for svc in $APP_SERVICES; do
        if ! $DOCKER image inspect "jawcold-rollback/$svc:previous" >/dev/null 2>&1; then
            warn "Brak zapisanej poprzedniej wersji ($svc)."
            return 1
        fi
    done
    for svc in $APP_SERVICES; do
        img="$(image_of "$svc")"
        $DOCKER tag "jawcold-rollback/$svc:previous" "$img"
    done
    $COMPOSE up -d --no-build --pull never $APP_SERVICES && log "Przywrócono poprzednią wersję."
}

cmd_apply() {
    $COMPOSE up -d --remove-orphans && log "Konfiguracja zastosowana."
}

cmd_restart() {
    $COMPOSE restart $APP_SERVICES
}

case "${1:-status}" in
    status) $COMPOSE ps; echo; echo "wersja: $($COMPOSE exec -T backend cat app/VERSION 2>/dev/null || echo '?')" ;;
    update) cmd_update ;;
    rollback) cmd_rollback ;;
    apply) cmd_apply ;;
    restart) cmd_restart ;;
    logs) $COMPOSE logs --tail "${3:-200}" "${2:-backend}" ;;
    *) sed -n '2,14p' "$0"; exit 1 ;;
esac
